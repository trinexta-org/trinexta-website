# Base de données
DATABASE_URL=postgresql://trinexta:dev_password@localhost:5432/trinexta

# URL publique du site (CRITIQUE pour les balises OG et les URLs absolues)
# local   : http://localhost:3000
# staging : https://staging.trinexta.fr
# prod    : https://trinexta.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_DATASET=production
SANITY_API_TOKEN=
# Même secret que le champ Secret du webhook « Alerte Newsletter Nouvel Article ».
# Générer avec : openssl rand -hex 32. Sans secret, la route refuse les envois.
SANITY_WEBHOOK_SECRET=

# Azure (envoi d'emails via Microsoft Graph)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_FROM_EMAIL=contact@trinexta.fr
# Expéditeur des confirmations d'inscription et des nouveaux articles uniquement.
NEWSLETTER_FROM_EMAIL=newsletter@trinexta.fr
SUPPORT_EMAIL="support@trinexta.fr"

# Google Places API (carte d'intervention)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Tag Manager (Analytics & RGPD)
NEXT_PUBLIC_GTM_ID=

# Google Ads - suivi des conversions (ex. AW-16975609254), chargé sous consentement
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversions ameliorees Google Ads : envoie l'email et le telephone du lead
# haches en SHA-256 avec la conversion, pour rattacher les parcours
# mobile -> desktop. Laisser a false tant que, DANS le compte Google Ads :
#   1. les conditions Donnees Client ne sont pas acceptees
#   2. l'action de conversion n'est pas basculee en "conversions ameliorees"
# Sans ces deux prerequis Google ignore la donnee : on ne l'envoie pas.
NEXT_PUBLIC_ADS_ENHANCED_CONVERSIONS=false

# Intelligence Artificielle (outils de dev et workflows)
ANTHROPIC_API_KEY=

# Tunnel d'estimation
# Lien Microsoft Bookings pour le CTA "Prendre rendez-vous" (laisser vide tant que non fourni)
NEXT_PUBLIC_BOOKINGS_URL=

